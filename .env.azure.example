# Azure の共有 MySQL（gen12-mysql-pos）に接続するための設定のひな形（アプリ用）。
# 使い方：cp .env.azure.example .env.azure して値を埋める。.env.azure はコミットしない（.gitignore）
# 管理用（DDL・ユーザー作成）の接続情報は .env.azure.admin に分け、アプリのコンテナには渡さない
#
# 書き方の注意（docker compose の env_file として読ませるため）
#   - 値は必ず単引用符 '…' で囲む。$ や # を含むパスワードでも、そのままの文字列として渡される
#   - 単引用符で囲むと docker compose の変数展開（${...}）も行われない
#   - 値の中に単引用符が含まれる場合だけ、'…'"'"'…' のように分けて書く
#   - = の前後に空白を入れない。行末に空白やコメントを付けない

APP_ENV='development'

# 接続先。パスワードは DATABASE_URL に埋め込まず、DB_PASSWORD から読んで URL エンコードする
DB_HOST='gen12-mysql-pos.mysql.database.azure.com'
DB_PORT='3306'
DB_NAME='pos_oguchan'

# アプリ用の DB ユーザー（DML のみ。design.md 7.5）。docs/azure_notes.md の手順で作る
DB_USER='pos_app_oguchan'
DB_PASSWORD='ここにアプリ用ユーザーのパスワードを貼る'

# require_secure_transport=ON のため SSL は必須。system = OS の CA でサーバ証明書を検証する
DB_SSL_CA='system'

# ローカルの Docker と同じ値でよい（ローカルの .env からコピーする）
JWT_SECRET_KEY='ここに .env と同じ値を貼る'

# テスト用（design.md 6.3）。APP_ENV=production では無視される
ACCESS_TOKEN_TTL_SECONDS='3600'
TEST_FIXED_NOW='2026-09-05T12:00:00'

# BFF（Next.js コンテナ）からの呼び出しだけを許可する
CORS_ALLOW_ORIGINS='http://frontend:3000'
