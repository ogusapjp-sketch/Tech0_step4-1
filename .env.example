# .env.example をコピーして .env を作り、値を設定する。.env はコミットしない

# 未設定なら本番扱い（docs 無効、Cookie に Secure 付与、テスト用の環境変数を無視）。ローカルでは development にする
APP_ENV=development
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=pos
APP_DB_USER=pos_app
APP_DB_PASSWORD=change-me-app
JWT_SECRET_KEY=change-me-to-a-long-random-string

# テスト用（design.md 6.3）。APP_ENV=production では無視される
ACCESS_TOKEN_TTL_SECONDS=3600
TEST_FIXED_NOW=
